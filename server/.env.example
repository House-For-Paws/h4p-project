PORT=5000
CLIENT_URL=http://localhost:5173
# Required: 16+ characters, not a common placeholder
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=h4p

# Required: 16+ characters, used only for POST /auth/promote
ADMIN_SECRET=replace-with-another-long-random-string
# Production: promote is off unless this is true
ENABLE_ADMIN_PROMOTE=false

# --- Optional outgoing mail ---
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
